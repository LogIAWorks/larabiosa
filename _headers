# Cabeceras de seguridad (las aplica Netlify o Cloudflare Pages al servir el sitio).
# El sitio es estático: sin backend, sin cookies propias, sin analítica.
# Único contenido externo: el módulo de reservas de CoverManager en un iframe.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(self "https://www.covermanager.com")
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; media-src 'self'; frame-src https://www.covermanager.com; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self' https://www.covermanager.com; frame-ancestors 'self'; upgrade-insecure-requests

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/*.html
  Cache-Control: public, max-age=0, must-revalidate
